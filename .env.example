# ANIMEDEX secrets. Copy to .env (gitignored) and fill. One KEY=VALUE per line, no inline comments.

# Any OpenAI-compatible API (OpenRouter, vLLM, LM Studio, hosted). Unused while every slot is on a CLI.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Model calls use your Claude and ChatGPT subscriptions through the claude and codex CLIs (G1a).
# Leave these two empty: a key here would never reach the CLIs, which get a stripped environment,
# but keeping them empty makes the intent plain.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web search backend chosen in config/settings.yaml (search.backend)
SEARCH_API_KEY=
