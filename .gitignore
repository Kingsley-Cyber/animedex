.control-state/
.beads/
.dolt/

# Beads / Dolt files (added by bd init)
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# ANIMEDEX: only data/canonical/ is committed (owner ruling, G0)
data/raw/
data/candidates/
data/quarantine/
data/cache/
data/adjudication/
data/blind/
data/backtest/
/build/
.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
graft/

# External-engine indexes (URCP: derived, never committed)
.codegraph/

# Generated ontology proposals (canonicalize): model values, gold ones included, so never committed while the blind test is pending. Hand-written plans stay as top-level .md files.
ontology/proposals/*/

# Model outputs never go to git: canonical profiles, agreement reruns, blind packets (blind and partner
# rules while annotations are pending; the repo is public). The folders stay via .gitkeep.
data/canonical/*
!data/canonical/.gitkeep
eval/agreement/*
!eval/agreement/.gitkeep
eval/blind/*
!eval/blind/.gitkeep
# `make audit` sheets (atom text with evidence trails; Kingsley marks them): private, backed up with data-push
eval/audit/*
!eval/audit/.gitkeep

# Kingsley's own inputs stay private (backed up to the private data repo with `make data-push`):
# steering rules, fight-image seeds, diagnosed concepts
steering/
seeds/
data/diagnose/
data/commentary/

# operate tools (request A): private job records and title queues
data/jobs/
data/queue/
# light path (2026-09-27): the notes index is private (mirrored to the data repo)
notes/
