    "power_combat.progression": {
      "enum": [
        "lateral",
        "linear",
        "hybrid",
        "none"
      ],
      "alternate_labels": {},
      "cq_refs": [
        "CQ-G04",
        "CQ-I04"
      ],
      "tests": {
        "lateral": "Growth adds new tools, techniques or uses without a clear rise in raw power; if each gain mainly raises one measurable strength, choose linear.",
        "linear": "Growth is a climb in raw strength along one axis, and the stronger side usually wins; if new abilities matter as much as the climb, choose hybrid.",
        "hybrid": "Growth both raises raw strength and adds distinct new tools, and fights lean on both; if one of the two clearly drives most fights, choose that one.",
        "none": "Power stays essentially fixed and users only polish what they already have; if a new use or technique changes how fights go, choose lateral."
      }
    },
    "power_combat.gate": {
      "enum": [
        "innate",
        "trained",
        "inherited",
        "contract",
        "system_granted",
        "artifact",
        "death_or_ritual",
        "mutation",
        "none",
        "other"
      ],
      "alternate_labels": {
        "system_granted": [
          "game system",
          "status window"
        ]
      },
      "cq_refs": [
        "CQ-G01",
        "CQ-I03"
      ],
      "tests": {
        "innate": "The user is born with it or it wakes on its own, with no lineage, deal or training behind it; if it runs down a bloodline, choose inherited.",
        "trained": "Study and practice that most people could undertake open the power; if practice only sharpens a power the user was born with, choose innate.",
        "inherited": "The power passes down a bloodline or from a predecessor to a chosen heir; if the user simply has it with no lineage or handover, choose innate.",
        "contract": "A bargain with an entity grants the power, including a wish an entity grants during a catastrophe; if dying or a ceremony grants it with no bargain, choose death_or_ritual.",
        "system_granted": "A game-like system or interface hands out the power and tracks it by its own rules; if a speaking entity strikes a deal instead, choose contract.",
        "artifact": "The power lives in an object anyone holding it can wield, and losing it removes the power; if the object only focuses the user's own power, choose that gate.",
        "death_or_ritual": "Dying, nearly dying, or a ceremony is the event that grants the power; if an entity strikes a bargain in that moment, choose contract.",
        "mutation": "An accident, experiment, infection or evolution changes the body, and the power comes from that change; if the user was simply born different, choose innate.",
        "none": "No one holds extraordinary power and fights run on ordinary skill; if training pushes skill to superhuman feats, choose trained.",
        "other": "No listed gate fits even loosely, so write other:<short phrase> naming the route; if a listed gate fits with a small stretch, use that gate."
      }
    },
    "power_combat.cost_of_power": {
      "enum": [
        "physical_toll",
        "lifespan",
        "memory",
        "identity_or_humanity",
        "relationships",
        "resource",
        "moral",
        "self_imposed_restriction",
        "imposed_penalty",
        "none",
        "other"
      ],
      "alternate_labels": {},
      "cq_refs": [
        "CQ-G01",
        "CQ-I11",
        "CQ-I25"
      ],
      "tests": {
        "physical_toll": "Using power injures or exhausts the body in ways that heal or recover; if each use permanently shortens the user's life, choose lifespan.",
        "lifespan": "Each use permanently takes time off the user's life; if the damage is injury or exhaustion the body recovers from, choose physical_toll.",
        "memory": "Using power erases specific memories the user had; if the user loses who they are, their feelings or their humanity, choose identity_or_humanity.",
        "identity_or_humanity": "Power erodes who the user is, turning their personality or humanity into something else; if only specific recollections vanish, choose memory.",
        "relationships": "Using power endangers, estranges or drives away the people the user loves; if the price is guilt over wrongs the user commits, choose moral.",
        "resource": "Power spends a finite outside supply such as money, fuel, stored energy or rare materials; if the supply is the user's own body or life, choose physical_toll or lifespan.",
        "moral": "Using power demands that the user hurt, kill or betray, and guilt is the price; if the loss is bonds with loved ones, choose relationships.",
        "self_imposed_restriction": "The user chooses a limit or vow that makes the power stronger; if an outside authority enforces the limit with punishment, choose imposed_penalty.",
        "imposed_penalty": "An outside authority or system punishes failure or disobedience with harm; if the user picked the limit themselves to gain strength, choose self_imposed_restriction.",
        "none": "Power costs its user nothing lasting and limits are only skill or stamina in the moment; if the story dwells on bodily strain as the price, choose physical_toll.",
        "other": "No listed cost fits even loosely, so write other:<short phrase> naming the cost; if a listed cost fits with a small stretch, use that cost."
      }
    },
    "power_combat.visible_counter": {
      "enum": [
        "numeric_level",
        "rank_tier",
        "collectible_count",
        "transformation_stage",
        "gauge",
        "none",
        "other"
      ],
      "alternate_labels": {},
      "cq_refs": [
        "CQ-I06",
        "CQ-I04"
      ],
      "tests": {
        "numeric_level": "A number the audience can read states the power, such as a level or a stat; if the display is a named grade or rank, choose rank_tier.",
        "rank_tier": "A named grade, class or rank on an ordered ladder shows standing; if the audience reads an exact number instead, choose numeric_level.",
        "collectible_count": "Progress is a count of things gathered, such as items, allies, marks or defeated rivals; if the count is one level number, choose numeric_level.",
        "transformation_stage": "Progress shows as the body or form visibly changing through named stages; if the stages are grades with no visible change, choose rank_tier.",
        "gauge": "A filling meter or percentage the audience watches approach a threshold; if the number climbs with no threshold to reach, choose numeric_level.",
        "none": "Nothing on screen measures progress, and a category label is not a counter, so an unordered power type or class is none; if labels form a ladder, choose rank_tier.",
        "other": "No listed display fits even loosely, so write other:<short phrase> naming it; if a listed display fits with a small stretch, use that display."
      }
    },
