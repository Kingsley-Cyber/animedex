{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "cache_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "pass": {
          "enum": [
            "P1",
            "VERIFY",
            "P2",
            "P3",
            "CHECK",
            "P4",
            "CANONICALIZE",
            "EP",
            "ROLLUP",
            "PATTERNS",
            "IDEATE",
            "CENSUS"
          ],
          "title": "Pass",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "vocab_version": {
          "minLength": 1,
          "title": "Vocab Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "pass",
        "schema_version",
        "vocab_version",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "v1.6 census: counts only (trust: recall). Never an atom, evidence, or ideation input.",
  "properties": {
    "adaptation": {
      "anyOf": [
        {
          "enum": [
            "adapted",
            "announced",
            "none"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adaptation"
    },
    "batch_id": {
      "minLength": 1,
      "title": "Batch Id",
      "type": "string"
    },
    "borrowed_system": {
      "anyOf": [
        {
          "enum": [
            "game",
            "exam_or_school",
            "job_or_bureaucracy",
