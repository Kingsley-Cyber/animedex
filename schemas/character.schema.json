          "enum": [
            "P1",
            "VERIFY",
            "P2",
            "P3",
            "CHECK",
            "P4",
            "CANONICALIZE",
            "EP",
            "ROLLUP",
            "PATTERNS",
            "IDEATE",
            "CENSUS"
