{
  "$defs": {
    "ConditionalTrait": {
      "additionalProperties": false,
      "description": "A flaw or moral line with its condition (when the flaw shows / what would make them cross it).",
      "properties": {
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "condition"
      ],
      "title": "ConditionalTrait",
      "type": "object"
    },
    "CreativityMove": {
      "additionalProperties": false,
      "description": "A use beyond the power's obvious design, with the page it is documented on.",
      "properties": {
        "move": {
          "title": "Move",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "move",
        "source_ref"
      ],
      "title": "CreativityMove",
      "type": "object"
    },
    "EpisodeLocator": {
      "additionalProperties": false,
      "description": "Where a turning point happens. Non-film titles need the episode (checked against the title).",
      "properties": {
        "episode": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode"
        },
        "season": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season"
        }
      },
      "title": "EpisodeLocator",
      "type": "object"
    },
    "KitForm": {
      "additionalProperties": false,
      "description": "A named stage of the power, with what triggers it and what it costs.",
      "properties": {
        "cost": {
          "title": "Cost",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "name",
        "trigger",
        "cost"
      ],
      "title": "KitForm",
      "type": "object"
    },
    "KitTool": {
      "additionalProperties": false,
      "description": "A signature application of a power, naming the kit function it exploits.",
      "properties": {
        "function": {
          "title": "Function",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "function"
      ],
      "title": "KitTool",
      "type": "object"
    },
    "PowerKit": {
      "additionalProperties": false,
      "description": "What a powered character can do (v1.8 \u00a75). `stat_block` kits generate drama through\n`drama_source`; every other kit through creativity (level, backed by sourced moves).",
      "properties": {
        "creativity_level": {
          "anyOf": [
            {
              "enum": [
                "literal",
                "inventive",
                "transcendent"
              ],
              "type": "string",
              "x-vocab": "character.creativity_level"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creativity Level"
        },
        "creativity_moves": {
          "items": {
            "$ref": "#/$defs/CreativityMove"
          },
          "maxItems": 3,
          "title": "Creativity Moves",
          "type": "array"
        },
        "drama_source": {
          "anyOf": [
            {
              "enum": [
                "restraint",
                "vulnerability",
                "corruption",
                "isolation",
                "other"
              ],
              "type": "string",
              "x-vocab": "character.drama_source"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drama Source"
        },
        "evolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evolution"
        },
        "forms": {
          "items": {
            "$ref": "#/$defs/KitForm"
          },
          "maxItems": 5,
          "title": "Forms",
          "type": "array"
        },
        "functions": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Functions",
          "type": "array"
        },
        "limits": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Limits",
          "type": "array"
        },
        "medium": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medium"
        },
        "power_kind": {
          "enum": [
            "medium",
            "stat_block",
            "technique_system",
            "bound_entity",
            "object",
            "system_interface",
            "skill_or_trait",
            "none"
          ],
          "title": "Power Kind",
          "type": "string",
          "x-vocab": "character.power_kind"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/KitTool"
          },
          "maxItems": 5,
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "power_kind"
      ],
      "title": "PowerKit",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
