        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "vocab_version": {
          "minLength": 1,
          "title": "Vocab Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "pass",
        "schema_version",
        "vocab_version",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "TurningPoint": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "title": "Event",
          "type": "string"
        },
