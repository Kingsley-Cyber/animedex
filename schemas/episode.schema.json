{
  "$defs": {
    "AtomSupport": {
      "additionalProperties": false,
      "properties": {
        "atom_id": {
          "title": "Atom Id",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "relation": {
          "enum": [
            "supports",
            "contradicts",
            "reframes"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "atom_id",
        "relation",
        "note"
      ],
      "title": "AtomSupport",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "minLength": 1,
          "title": "Actual",
          "type": "string"
        },
        "agent": {
          "minLength": 1,
          "title": "Agent",
          "type": "string"
        },
        "choice": {
          "minLength": 1,
          "title": "Choice",
          "type": "string"
        },
        "expected": {
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "goal": {
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "rejected": {
          "minLength": 1,
          "title": "Rejected",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "goal",
        "options",
        "choice",
        "rejected",
        "expected",
        "actual"
      ],
      "title": "Decision",
      "type": "object"
    },
    "EngineBeat": {
      "additionalProperties": false,
      "properties": {
        "advances": {
          "enum": [
            "goal",
            "constraint",
            "strategy",
            "benefit",
            "cost",
            "dilemma"
          ],
          "title": "Advances",
          "type": "string"
        },
        "engine_atom_id": {
          "title": "Engine Atom Id",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "engine_atom_id",
        "advances",
        "note"
      ],
      "title": "EngineBeat",
      "type": "object"
    },
    "EpisodeLocator": {
      "additionalProperties": false,
      "properties": {
        "episode": {
          "minimum": 0,
          "title": "Episode",
          "type": "integer"
        },
        "episode_title": {
          "default": "",
          "title": "Episode Title",
          "type": "string"
        },
        "numbering": {
          "enum": [
            "broadcast",
            "streaming",
            "home_video"
          ],
          "title": "Numbering",
          "type": "string",
          "x-vocab": "scope.numbering"
        },
        "season": {
          "minimum": 0,
          "title": "Season",
          "type": "integer"
        }
      },
      "required": [
        "season",
        "episode",
        "numbering"
      ],
      "title": "EpisodeLocator",
      "type": "object"
    },
    "InfoShift": {
      "additionalProperties": false,
      "properties": {
        "audience_learns": {
          "default": "",
          "title": "Audience Learns",
          "type": "string"
        },
        "characters_learn": {
          "default": "",
          "title": "Characters Learn",
          "type": "string"
        },
        "gap_change": {
          "enum": [
            "widens",
            "narrows",
            "flips",
            "none"
          ],
          "title": "Gap Change",
          "type": "string",
          "x-vocab": "info_shift.gap_change"
        }
      },
      "required": [
        "gap_change"
      ],
      "title": "InfoShift",
      "type": "object"
    },
    "Payoff": {
      "additionalProperties": false,
      "properties": {
        "payoff": {
          "title": "Payoff",
          "type": "string"
        },
        "setup_episode_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup Episode Id"
        }
      },
      "required": [
        "payoff"
      ],
      "title": "Payoff",
      "type": "object"
    },
    "ProposedAtom": {
      "additionalProperties": false,
      "properties": {
        "atom_kind": {
          "enum": [
            "effect",
            "engine"
          ],
          "title": "Atom Kind",
          "type": "string",
          "x-vocab": "atom_kind"
        },
        "draft": {
          "title": "Draft",
          "type": "string"
        }
      },
      "required": [
        "atom_kind",
        "draft"
      ],
      "title": "ProposedAtom",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "cache_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "pass": {
          "enum": [
            "P1",
            "VERIFY",
            "P2",
            "P3",
            "CHECK",
            "P4",
            "CANONICALIZE",
            "EP",
            "ROLLUP",
            "PATTERNS",
            "IDEATE"
          ],
          "title": "Pass",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "vocab_version": {
          "minLength": 1,
          "title": "Vocab Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "pass",
        "schema_version",
        "vocab_version",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Episode evidence record (M6). Never created from recall: source must be a fetched URL.",
  "properties": {
    "atom_support": {
      "items": {
        "$ref": "#/$defs/AtomSupport"
      },
      "title": "Atom Support",
      "type": "array"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "end_hook": {
      "enum": [
        "threat_cliffhanger",
        "reveal_cliffhanger",
        "open_question",
        "power_tease",
        "emotional_resolution",
        "none",
        "other"
      ],
      "title": "End Hook",
      "type": "string",
      "x-vocab": "episode.end_hook"
    },
    "engine_beat": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngineBeat"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "function": {
      "enum": [
        "pilot_hook",
        "setup",
        "escalation",
        "reversal",
        "revelation",
        "payoff",
        "respite",
        "closure",
        "other"
      ],
      "title": "Function",
      "type": "string",
      "x-vocab": "episode.function"
    },
    "info_shift": {
      "$ref": "#/$defs/InfoShift"
    },
    "locator": {
      "$ref": "#/$defs/EpisodeLocator"
    },
    "moment_refs": {
      "items": {
        "type": "string"
      },
      "title": "Moment Refs",
      "type": "array"
    },
    "payoffs": {
      "items": {
        "$ref": "#/$defs/Payoff"
      },
      "title": "Payoffs",
      "type": "array"
    },
    "proposed_atoms": {
      "items": {
        "$ref": "#/$defs/ProposedAtom"
      },
      "title": "Proposed Atoms",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "selection_reason": {
      "enum": [
        "pilot",
        "moment",
        "finale",
        "control"
      ],
      "title": "Selection Reason",
      "type": "string",
      "x-vocab": "episode.selection_reason"
    },
    "setups": {
      "items": {
        "type": "string"
      },
      "title": "Setups",
      "type": "array"
    },
    "source": {
      "const": "web",
      "title": "Source",
      "type": "string"
    },
    "source_ref": {
      "minLength": 1,
      "title": "Source Ref",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "title_id": {
      "title": "Title Id",
      "type": "string"
    },
    "verification": {
      "enum": [
        "web_confirmed",
        "unresolved"
      ],
      "title": "Verification",
      "type": "string"
    }
  },
  "required": [
    "episode_id",
    "title_id",
    "locator",
    "selection_reason",
    "summary",
    "function",
    "end_hook",
    "info_shift",
    "source",
    "source_ref",
    "verification",
    "provenance"
  ],
  "title": "Episode",
  "type": "object"
}
