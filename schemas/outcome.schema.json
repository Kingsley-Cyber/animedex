{
  "$defs": {
    "Adaptation": {
      "additionalProperties": false,
      "description": "v1.9: a print title's screen adaptation, read from the catalog's relations (never from recall).",
      "properties": {
        "catalog_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Ref"
        },
        "screen_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screen Title"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "status": {
          "enum": [
            "adapted",
            "announced",
            "none"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Adaptation",
      "type": "object"
    },
    "Confounders": {
      "additionalProperties": false,
      "properties": {
        "budget_signal": {
          "default": "",
          "title": "Budget Signal",
          "type": "string"
        },
        "platform": {
          "default": "",
          "title": "Platform",
          "type": "string"
        },
        "release_context": {
          "default": "",
          "title": "Release Context",
          "type": "string"
        },
        "source_popularity": {
          "default": "",
          "title": "Source Popularity",
          "type": "string"
        },
        "studio": {
          "default": "",
          "title": "Studio",
          "type": "string"
        }
      },
      "title": "Confounders",
      "type": "object"
    },
    "FailurePattern": {
      "additionalProperties": false,
      "description": "v1.8: how a mixed/flop title failed, with the page that says so. Pre-mortems and graveyard\nwarnings cite these.",
      "properties": {
        "note": {
          "title": "Note",
          "type": "string"
        },
        "pattern": {
          "enum": [
            "promise_broken",
            "power_scaling_collapse",
            "villain_deflation",
            "cast_bloat",
            "pacing_collapse",
            "adaptation_compression",
            "tone_whiplash",
            "protagonist_passivity",
            "ending_failure",
            "production_quality",
            "other"
          ],
          "title": "Pattern",
          "type": "string",
          "x-vocab": "outcome.failure_pattern"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "pattern",
        "source_ref",
        "note"
      ],
      "title": "FailurePattern",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "cache_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "pass": {
          "enum": [
            "P1",
            "VERIFY",
            "P2",
            "P3",
            "CHECK",
            "P4",
            "CANONICALIZE",
            "EP",
            "ROLLUP",
            "PATTERNS",
            "IDEATE",
            "CENSUS"
          ],
          "title": "Pass",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "vocab_version": {
          "minLength": 1,
          "title": "Vocab Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "pass",
        "schema_version",
        "vocab_version",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Signal": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "value",
        "source_ref"
      ],
      "title": "Signal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "External-metric outcome record (VERIFY).",
  "properties": {
    "adaptation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Adaptation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confounders": {
      "$ref": "#/$defs/Confounders"
    },
    "failure_evidence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Evidence"
    },
    "failure_evidence_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Evidence Ref"
    },
    "failure_level": {
      "anyOf": [
        {
          "enum": [
            "premise",
            "execution",
            "external",
            "unknown"
          ],
          "type": "string",
          "x-vocab": "outcome.failure_level"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Level"
    },
    "failure_level_source": {
      "anyOf": [
        {
          "enum": [
            "verify",
            "owner",
            "migration"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Level Source"
    },
    "failure_patterns": {
      "items": {
        "$ref": "#/$defs/FailurePattern"
      },
      "title": "Failure Patterns",
      "type": "array"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "label": {
      "enum": [
        "hit",
        "mixed",
        "flop"
      ],
      "title": "Label",
      "type": "string",
      "x-vocab": "core.outcome"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/Signal"
      },
      "title": "Signals",
      "type": "array"
    },
    "title_id": {
      "title": "Title Id",
      "type": "string"
    }
  },
  "required": [
    "title_id",
    "label",
    "provenance"
  ],
  "title": "Outcome",
  "type": "object"
}
