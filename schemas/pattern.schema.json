{
  "$defs": {
    "Counterexample": {
      "additionalProperties": false,
      "properties": {
        "title_id": {
          "title": "Title Id",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "title_id",
        "why"
      ],
      "title": "Counterexample",
      "type": "object"
    },
    "PredictiveEvidence": {
      "additionalProperties": false,
      "description": "A load-bearing atom in a held-out title (one the principle was not extracted from) that the\ncard's principle explains (v1.8 M7 principle test).",
      "properties": {
        "atom_id": {
          "title": "Atom Id",
          "type": "string"
        },
        "title_id": {
          "title": "Title Id",
          "type": "string"
        }
      },
      "required": [
        "title_id",
        "atom_id"
      ],
      "title": "PredictiveEvidence",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "cache_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "pass": {
          "enum": [
            "P1",
            "VERIFY",
            "P2",
            "P3",
            "CHECK",
            "P4",
            "CANONICALIZE",
            "EP",
            "ROLLUP",
            "PATTERNS",
            "IDEATE",
            "CENSUS"
          ],
          "title": "Pass",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "vocab_version": {
          "minLength": 1,
          "title": "Vocab Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "pass",
        "schema_version",
        "vocab_version",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Pattern card (M7). 04 requires a recorded counterexample search; see AC-40. v1.8: a card is\n`predictive` only with evidence from a held-out title; only predictive principles feed ideation.",
  "properties": {
    "alternative_explanations": {
      "items": {
        "type": "string"
      },
      "title": "Alternative Explanations",
      "type": "array"
    },
    "boundary_conditions": {
      "items": {
        "type": "string"
      },
      "title": "Boundary Conditions",
      "type": "array"
    },
    "counterexamples": {
      "items": {
        "$ref": "#/$defs/Counterexample"
      },
      "title": "Counterexamples",
      "type": "array"
    },
    "pattern_id": {
      "title": "Pattern Id",
      "type": "string"
    },
    "predictive": {
      "default": false,
      "title": "Predictive",
      "type": "boolean"
    },
    "predictive_evidence": {
      "items": {
        "$ref": "#/$defs/PredictiveEvidence"
      },
      "title": "Predictive Evidence",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "scope": {
      "enum": [
        "title",
        "corpus_subset",
        "corpus"
      ],
      "title": "Scope",
      "type": "string"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    },
    "supporting_titles": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Supporting Titles",
      "type": "array"
    },
    "transfer_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Transfer Ids",
      "type": "array"
    }
  },
  "required": [
    "pattern_id",
    "statement",
    "transfer_ids",
    "supporting_titles",
    "scope",
    "provenance"
  ],
  "title": "PatternCard",
  "type": "object"
}
